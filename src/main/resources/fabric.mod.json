{
  "schemaVersion": 1,
  "id": "magicdonut",
  "version": "${version}",
  "name": "MagicDonut",
  "description": "A utility mod for DonutSMP, done right.",
  "authors": [
    "MagicClutch",
    "Taubsie"
  ],
  "contact": {
    "discord": "https://discord.gg/Rs9UAysV4B"
  },
  "license": "All-Rights-Reserved",
  "icon": "assets/magicdonut/icon.png",
  "environment": "client",
  "entrypoints": {
    "fabric-datagen": [
      "de.magicclutch.magicdonut.client.MagicDonutDataGenerator"
    ],
    "client": [
      "de.magicclutch.magicdonut.client.MagicDonutClient"
    ],
    "main": [
      "de.magicclutch.magicdonut.MagicDonut"
    ],
    "modmenu": [
      "de.magicclutch.magicdonut.client.config.ModMenuIntegration"
    ]
  },
  "mixins": [
    "magicdonut.mixins.json",
    {
      "config": "magicdonut.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-language-kotlin": ">=${kotlin_loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}",
    "yet_another_config_lib_v3": ">=${yacl_version}"
  },
  "suggests": {
    "modmenu": ">=${modmenu_version}"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.discord": "https://discord.gg/Rs9UAysV4B"
      }
    }
  }
}
